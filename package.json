{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "lint:ci": "node scripts/lint-ci.mjs",
    "test": "vitest",
    "test:touring": "vitest run src/hooks/__tests__/useTourCancellation.contract.test.ts src/hooks/__tests__/useTourCatchUp.test.tsx src/hooks/__tests__/useTourTravelRepair.messages.test.ts src/hooks/__tests__/useTourTravelRepair.test.tsx src/lib/api/__tests__/tourCatchUp.database.test.ts src/lib/api/__tests__/tourCatchUpHook.contract.test.ts src/lib/api/__tests__/tourManagerTravelRepair.contract.test.ts src/lib/api/__tests__/tourManagerTravelRepair.source.test.ts src/lib/api/__tests__/tourTravel.database.test.ts src/lib/api/__tests__/tourVenueCostsMigrationOrder.database.test.ts src/lib/api/__tests__/tours.database.test.ts src/pages/__tests__/TourManager.authority.test.ts src/utils/__tests__/tourOperations.test.ts",
    "test:festivals": "vitest run src/features/festival-company src/features/festivals src/pages/FestivalOwnerConsole.test.ts",
    "test:e2e:festival:pr": "playwright test tests/festivals/london-fixture.spec.ts --project=chromium",
    "test:e2e:festival:main": "playwright test tests/festivals --project=chromium",
    "certification:festival-phase10": "node --test scripts/festivals/vitest-serial-certification.test.mjs && npm run test:touring && npm run test:festivals && npm run test:festivals:routes && npm run test:festivals:route-components && npm run test:festivals:active-callers",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test:unit": "vitest run",
    "test:smoke": "vitest run src/testing/__tests__/betaSmokeScenarios.test.ts src/components/dashboard/GettingStartedPanel.test.ts src/utils/__tests__/activityBookingTime.test.ts src/lib/managerRecommendations.test.ts",
    "test:recruitment:db": "bash -lc 'if ! command -v supabase >/dev/null; then echo Supabase CLI is required for recruitment DB tests; exit 127; fi; if [ -z \"$SUPABASE_DB_URL\" ]; then echo SUPABASE_DB_URL is required after supabase start/db reset; exit 2; fi; psql \"$SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -f supabase/tests/recruitment_rls_harness.sql'",
    "test:contributions:db": "bash -lc 'if ! command -v supabase >/dev/null; then echo Supabase CLI is required for contribution DB tests; exit 127; fi; if [ -z \"$SUPABASE_DB_URL\" ]; then echo SUPABASE_DB_URL is required after supabase start/db reset; exit 2; fi; psql \"$SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -f supabase/tests/band_contribution_events_harness.sql'",
    "test:participants:db": "bash -lc 'if ! command -v supabase >/dev/null; then echo Supabase CLI is required for participant DB tests; exit 127; fi; if [ -z \"$SUPABASE_DB_URL\" ]; then echo SUPABASE_DB_URL is required after supabase start/db reset; exit 2; fi; psql \"$SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -f supabase/tests/rehearsal_gig_participants_harness.sql'",
    "test:corrections:db": "bash -lc 'if ! command -v supabase >/dev/null; then echo Supabase CLI is required for correction DB tests; exit 127; fi; if [ -z \"$SUPABASE_DB_URL\" ]; then echo SUPABASE_DB_URL is required after supabase start/db reset; exit 2; fi; psql \"$SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -f supabase/tests/rehearsal_attendance_corrections_harness.sql'",
    "test:gig-experience:unit": "vitest run src/features/gig-experience/__tests__/GigExperienceService.test.ts src/features/gig-experience/components/**/*.test.tsx",
    "test:gig-experience:replay": "vitest run src/features/gig-experience/events/__tests__/schema.test.ts",
    "test:gig-experience:viewer": "vitest run src/features/gig-experience/viewer/tests src/features/gig-experience/viewer/audio/audioSourceResolver.test.ts",
    "test:gig-experience:component": "vitest run src/features/gig-experience/viewer/tests/browser/gigReplayBrowserGate.test.tsx",
    "test:gig-experience:browser": "vitest run src/features/gig-experience/viewer/tests/browser/gigReplayBrowserGate.test.tsx && npm run test:gig-experience:e2e",
    "test:gig-experience:a11y": "playwright test tests/gig-experience/a11y.spec.ts --project=chromium",
    "test:gig-experience:release": "node scripts/gigs/run-release-gate.mjs",
    "test:gig-experience:db": "bash scripts/gigs/run-db-gate.sh",
    "test:gig-experience:audio": "vitest run src/features/gig-experience/viewer/audio/audioSourceResolver.test.ts",
    "test:gig-experience:e2e": "playwright test tests/gig-experience/admin-demo.spec.ts tests/gig-experience/audio-lifecycle.spec.ts --project=chromium",
    "test:gig-experience:e2e:headed": "playwright test tests/gig-experience/admin-demo.spec.ts tests/gig-experience/audio-lifecycle.spec.ts --project=chromium --headed",
    "test:gig-experience:a11y:unit": "vitest run src/features/gig-experience/viewer/tests/browser/gigReplayBrowserGate.test.tsx",
    "test:achievements": "vitest run src/features/achievements/__tests__/validator.test.ts",
    "validate:balance": "vitest run src/balance/__tests__/balance.test.ts",
    "simulate:balance": "node scripts/progression-simulations/run-balance-simulations.mjs",
    "validate:progression-programme": "node scripts/progression/validate-programme.mjs",
    "test:festivals:db": "bash scripts/festivals/run-creation-phase1-db-gate.sh",
    "seed:festival:london": "PGOPTIONS=\"-c app.allow_test_fixtures=true\" psql \"$SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -f supabase/seeds/festival_london_test.sql",
    "verify:supabase-rpcs": "node scripts/supabase/verify-required-rpcs.mjs",
    "test:festivals:hardening:db": "bash scripts/festivals/run-hardening-db-gate.sh",
    "test:festivals:company-runtime": "bash scripts/festivals/run-company-runtime-gate.sh",
    "test:festivals:recovery": "bash scripts/festivals/run-lifecycle-recovery-db-gate.sh",
    "test:festivals:active-callers": "node scripts/festivals/certify-active-system.mjs --check",
    "test:festivals:routes": "node --test scripts/festivals/festival-routes.test.mjs",
    "test:festivals:app-routes": "vitest run --config vitest.routes.config.ts src/__tests__/App.routeRender.test.tsx",
    "test:festivals:route-components": "node --test scripts/festivals/route-component-certification.test.mjs",
    "test:festivals:artists:db": "bash scripts/festivals/run-artist-applications-db-gate.sh",
    "test:festivals:full-lifecycle": "bash scripts/festivals/run-full-lifecycle-db-gate.sh",
    "test:festivals:certification": "bash scripts/festivals/run-certification-gate.sh",
    "test:festivals:safety-guard": "vitest run scripts/festivals/assert-safe-test-database.test.mjs",
    "verify:dependencies": "npm ls --all",
    "verify:dependency-lock": "node --test scripts/dependency-lock-integrity.test.mjs",
    "verify:migration-timestamps": "node scripts/supabase/verify-migration-timestamps.mjs",
    "test:gig-booking:db": "bash -lc 'test -n \"$SUPABASE_DB_URL\" || { echo SUPABASE_DB_URL is required; exit 2; }; psql \"$SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -f supabase/tests/gig_booking_runtime_harness.sql'",
    "test:festivals:upgrades": "node --test scripts/festivals/festival-upgrade-catalogue.test.mjs",
    "diagnose:gig-booking:db": "bash -lc 'test -n \"$SUPABASE_DB_URL\" || { echo SUPABASE_DB_URL is required; exit 2; }; psql \"$SUPABASE_DB_URL\" -X -v ON_ERROR_STOP=1 -f supabase/diagnostics/gig_booking_runtime.sql'",
    "verify:gig-booking:deployment": "bash -lc 'test -n \"$SUPABASE_DB_URL\" || { echo SUPABASE_DB_URL is required; exit 2; }; psql \"$SUPABASE_DB_URL\" -X -v ON_ERROR_STOP=1 -f supabase/diagnostics/verify_gig_booking_deployment.sql'",
    "test:festivals:scheduling:db": "bash scripts/festivals/run-scheduling-db-gate.sh",
    "test:festivals:runtime:db": "bash scripts/festivals/run-edition-runtime-db-gate.sh",
    "test:festivals:runtime": "vitest run --config vitest.runtime.config.ts src/features/festivals/runtime/model.test.ts",
    "test:festivals:settlement:db": "bash scripts/festivals/run-settlement-db-gate.sh",
    "test:festivals:settlement": "vitest run --config vitest.settlement.config.ts src/features/festivals/settlement/model.test.ts src/features/festivals/settlement/outcomeLifecycle.test.ts",
    "test:festivals:effects": "vitest run --config vitest.settlement.config.ts supabase/functions/process-festival-settlement-effects/dispatcher.test.ts",
    "test:festivals:performance-effects": "node --test scripts/festivals/certify-performance-effects-harness.test.mjs && vitest run --config vitest.settlement.config.ts supabase/functions/_shared/__tests__/live-performance-progression.test.ts supabase/functions/process-festival-settlement-effects/dispatcher.test.ts",
    "test:festivals:performance-effects:db": "bash scripts/festivals/run-performance-effects-db-gate.sh",
    "test:festivals:upgrades:db": "bash scripts/festivals/run-upgrade-db-gate.sh",
    "test:finance:contract": "node --test scripts/finance/finance-verification-workflow.test.mjs",
    "test:finance:db": "bash scripts/finance/run-db-gate.sh",
    "test:e2e:finance": "playwright test --config=playwright.finance.config.ts --project=chromium"
  },
